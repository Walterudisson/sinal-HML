rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function memberPath(tenantId) { return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid); }
    function ticketPath(tenantId, ticketId) { return /databases/$(database)/documents/tenants/$(tenantId)/tickets/$(ticketId); }
    function resolutionPath(tenantId, ticketId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/tickets/$(ticketId)/private/resolution;
    }
    function statusEventPath(tenantId, ticketId, eventId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/tickets/$(ticketId)/statusEvents/$(eventId);
    }
    function messagePath(tenantId, ticketId, messageId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/tickets/$(ticketId)/messages/$(messageId);
    }
    function triageEventPath(tenantId, ticketId, eventId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/tickets/$(ticketId)/triageEvents/$(eventId);
    }

    function activeUser() {
      return signedIn() && exists(userPath()) && get(userPath()).data.status == 'active';
    }

    function superadmin() {
      return activeUser() && get(userPath()).data.platformRole == 'superadmin';
    }

    function activeMember(tenantId) {
      return activeUser()
        && exists(memberPath(tenantId))
        && get(memberPath(tenantId)).data.status == 'active';
    }

    function supportMember(tenantId) {
      return activeMember(tenantId)
        && get(memberPath(tenantId)).data.role in ['admin', 'supervisor', 'agente'];
    }

    function canReadTicket(tenantId, ticketId) {
      return activeMember(tenantId)
        && (
          get(ticketPath(tenantId, ticketId)).data.requesterUid == request.auth.uid
          || supportMember(tenantId)
        );
    }

    function canReplyToTicket(tenantId, ticketId) {
      return activeMember(tenantId)
        && exists(ticketPath(tenantId, ticketId))
        && get(ticketPath(tenantId, ticketId)).data.status != 'resolved'
        && (
          get(ticketPath(tenantId, ticketId)).data.requesterUid == request.auth.uid
          || (
            supportMember(tenantId)
            && get(ticketPath(tenantId, ticketId)).data.assigneeUid == request.auth.uid
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || superadmin());
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if superadmin() || activeMember(tenantId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if superadmin() || (activeMember(tenantId) && request.auth.uid == memberId);
        allow write: if false;

        match /notifications/{notificationId} {
          allow read: if activeMember(tenantId) && request.auth.uid == memberId;
          allow create, delete: if false;
          allow update: if activeMember(tenantId)
            && request.auth.uid == memberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
            && request.resource.data.isRead == true
            && request.resource.data.readAt == request.time;
        }

        match /devices/{deviceId} {
          allow read: if activeMember(tenantId) && request.auth.uid == memberId;
          allow create, update: if activeMember(tenantId)
            && request.auth.uid == memberId
            && request.resource.data.token is string
            && request.resource.data.token.size() > 20
            && request.resource.data.enabled is bool
            && request.resource.data.updatedAt == request.time;
          allow delete: if activeMember(tenantId) && request.auth.uid == memberId;
        }
      }

      match /tickets/{ticketId} {
        allow read: if activeMember(tenantId)
          && (resource.data.requesterUid == request.auth.uid || supportMember(tenantId));

        // 1.7.1-A: o solicitante abre por mensagem, sem escolher triagem.
        // A primeira mensagem deve ser criada no MESMO batch do ticket.
        allow create: if activeMember(tenantId)
          && request.resource.data.keys().hasOnly([
            'code','title','description','category','priority','status',
            'requesterUid','requesterName','requesterEmail','createdByUid',
            'source','assigneeUid','teamId','createdAt','updatedAt',
            'firstMessageId','lastInteractionAt','lastInteractionType',
            'lastInteractionByUid','lastInteractionMessageId'
          ])
          && request.resource.data.keys().hasAll([
            'code','title','description','category','priority','status',
            'requesterUid','requesterName','requesterEmail','createdByUid',
            'source','assigneeUid','teamId','createdAt','updatedAt',
            'firstMessageId','lastInteractionAt','lastInteractionType',
            'lastInteractionByUid','lastInteractionMessageId'
          ])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 3
          && request.resource.data.code.size() <= 20
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 3
          && request.resource.data.description.size() <= 4000
          && request.resource.data.category == null
          && request.resource.data.priority == null
          && request.resource.data.status == 'open'
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.requesterName == get(userPath()).data.displayName
          && request.resource.data.requesterEmail == get(userPath()).data.email
          && request.resource.data.source == 'web'
          && request.resource.data.assigneeUid == null
          && request.resource.data.teamId == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.firstMessageId is string
          && request.resource.data.firstMessageId.size() >= 10
          && request.resource.data.lastInteractionAt == request.time
          && request.resource.data.lastInteractionType == 'message'
          && request.resource.data.lastInteractionByUid == request.auth.uid
          && request.resource.data.lastInteractionMessageId == request.resource.data.firstMessageId
          && getAfter(messagePath(tenantId, ticketId,
            request.resource.data.firstMessageId)).data.body == request.resource.data.description
          && getAfter(messagePath(tenantId, ticketId,
            request.resource.data.firstMessageId)).data.authorUid == request.auth.uid
          && getAfter(messagePath(tenantId, ticketId,
            request.resource.data.firstMessageId)).data.createdAt == request.time;

        // Atribuição e resolução são transições distintas, vinculadas ao histórico.
        allow update: if (supportMember(tenantId) && (
          (
            resource.data.status == 'open'
            && resource.data.assigneeUid == null
            && request.resource.data.status == 'in_progress'
            && request.resource.data.assigneeUid == request.auth.uid
            && request.resource.data.assigneeName == get(userPath()).data.displayName
            && request.resource.data.assigneeEmail == get(userPath()).data.email
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastEventId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','assigneeUid','assigneeName','assigneeEmail','updatedAt','lastEventId'
            ])
            && getAfter(statusEventPath(tenantId, ticketId, request.resource.data.lastEventId)).data.type == 'claimed'
            && getAfter(statusEventPath(tenantId, ticketId, request.resource.data.lastEventId)).data.createdAt == request.time
          )
          ||
          (
            resource.data.status == 'in_progress'
            && resource.data.assigneeUid == request.auth.uid
            && request.resource.data.status == 'resolved'
            && request.resource.data.resolvedAt == request.time
            && request.resource.data.resolvedByUid == request.auth.uid
            && request.resource.data.resolvedByName == get(userPath()).data.displayName
            && request.resource.data.resolutionShared is bool
            && request.resource.data.publicResolution is string
            && request.resource.data.publicResolution.size() <= 2000
            && (
              (request.resource.data.resolutionShared
                && request.resource.data.publicResolution.size() >= 3)
              || (!request.resource.data.resolutionShared
                && request.resource.data.publicResolution == '')
            )
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastEventId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','resolvedAt','resolvedByUid','resolvedByName',
              'resolutionShared','publicResolution','updatedAt','lastEventId'
            ])
            && getAfter(resolutionPath(tenantId, ticketId)).data.createdAt == request.time
            && getAfter(resolutionPath(tenantId, ticketId)).data.createdByUid == request.auth.uid
            && getAfter(statusEventPath(tenantId, ticketId, request.resource.data.lastEventId)).data.type == 'resolved'
            && getAfter(statusEventPath(tenantId, ticketId, request.resource.data.lastEventId)).data.createdAt == request.time
          )
        )) || (
          activeMember(tenantId)
          && resource.data.status == 'resolved'
          && resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'in_progress'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','updatedAt'
          ])
        ) || (
          canReplyToTicket(tenantId, ticketId)
          && request.resource.data.lastInteractionAt == request.time
          && request.resource.data.lastInteractionType == 'message'
          && request.resource.data.lastInteractionByUid == request.auth.uid
          && request.resource.data.lastInteractionMessageId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastInteractionAt','lastInteractionType',
            'lastInteractionByUid','lastInteractionMessageId'
          ])
          && getAfter(messagePath(
            tenantId, ticketId, request.resource.data.lastInteractionMessageId
          )).data.authorUid == request.auth.uid
          && getAfter(messagePath(
            tenantId, ticketId, request.resource.data.lastInteractionMessageId
          )).data.createdAt == request.time
        ) || (
          // Alteração de título/classificação da equipe com evento imutável.
          supportMember(tenantId)
          && resource.data.status != 'resolved'
          && (
            get(memberPath(tenantId)).data.role in ['admin', 'supervisor']
            || resource.data.assigneeUid == null
            || resource.data.assigneeUid == request.auth.uid
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title','category','priority','updatedAt','lastTriageEventId'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'title','category','priority'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && (
            (request.resource.data.category == null && request.resource.data.priority == null)
            || (
              request.resource.data.category in ['acesso','equipamento','rede','sistemas','outro']
              && request.resource.data.priority in ['baixa','normal','alta','urgente']
            )
          )
          && (resource.data.category == null || request.resource.data.category != null)
          && (resource.data.priority == null || request.resource.data.priority != null)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastTriageEventId is string
          && request.resource.data.lastTriageEventId.size() >= 10
          && request.resource.data.lastTriageEventId != resource.data.get('lastTriageEventId', '')
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.actorUid == request.auth.uid
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.createdAt == request.time
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.fromTitle == resource.data.title
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.toTitle == request.resource.data.title
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.fromCategory == resource.data.category
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.toCategory == request.resource.data.category
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.fromPriority == resource.data.priority
          && getAfter(triageEventPath(
            tenantId, ticketId, request.resource.data.lastTriageEventId
          )).data.toPriority == request.resource.data.priority
        );

        allow delete: if false;

        // Nunca armazenar ou disponibilizar a solução técnica no ticket principal.
        match /private/{privateId} {
          allow read: if privateId == 'resolution' && supportMember(tenantId);
          allow create: if privateId == 'resolution'
            && supportMember(tenantId)
            && get(ticketPath(tenantId, ticketId)).data.status == 'in_progress'
            && get(ticketPath(tenantId, ticketId)).data.assigneeUid == request.auth.uid
            && getAfter(ticketPath(tenantId, ticketId)).data.status == 'resolved'
            && getAfter(ticketPath(tenantId, ticketId)).data.updatedAt == request.time
            && request.resource.data.keys().hasOnly([
              'text','knowledgeCandidate','createdByUid','createdByName','createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'text','knowledgeCandidate','createdByUid','createdByName','createdAt'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 3
            && request.resource.data.text.size() <= 4000
            && request.resource.data.knowledgeCandidate is bool
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.createdByName == get(userPath()).data.displayName
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /statusEvents/{eventId} {
          allow read: if canReadTicket(tenantId, ticketId);
          allow create: if supportMember(tenantId)
            && request.resource.data.keys().hasOnly([
              'type','from','to','actorUid','actorName','createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'type','from','to','actorUid','actorName','createdAt'
            ])
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.actorName == get(userPath()).data.displayName
            && request.resource.data.createdAt == request.time
            && getAfter(ticketPath(tenantId, ticketId)).data.lastEventId == eventId
            && getAfter(ticketPath(tenantId, ticketId)).data.updatedAt == request.time
            && getAfter(ticketPath(tenantId, ticketId)).data.assigneeUid == request.auth.uid
            && (
              (request.resource.data.type == 'claimed'
                && request.resource.data.from == 'open'
                && request.resource.data.to == 'in_progress'
                && getAfter(ticketPath(tenantId, ticketId)).data.status == 'in_progress')
              ||
              (request.resource.data.type == 'resolved'
                && request.resource.data.from == 'in_progress'
                && request.resource.data.to == 'resolved'
                && getAfter(ticketPath(tenantId, ticketId)).data.status == 'resolved')
            );
          allow update, delete: if false;
        }

        // Eventos de triagem imutáveis, vinculados à mesma escrita do ticket.
        match /triageEvents/{eventId} {
          // Histórico administrativo: não disponibilizar os dados internos
          // para o solicitante, mesmo sendo participante do sinal.
          allow read: if supportMember(tenantId)
            && canReadTicket(tenantId, ticketId);
          allow create: if supportMember(tenantId)
            && request.resource.data.keys().hasOnly([
              'type','fromTitle','toTitle','fromCategory','toCategory',
              'fromPriority','toPriority','actorUid','actorName','createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'type','fromTitle','toTitle','fromCategory','toCategory',
              'fromPriority','toPriority','actorUid','actorName','createdAt'
            ])
            && request.resource.data.type in ['classified','reclassified','title_changed']
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.actorName == get(userPath()).data.displayName
            && request.resource.data.createdAt == request.time
            && get(ticketPath(tenantId, ticketId)).data.status != 'resolved'
            && getAfter(ticketPath(tenantId, ticketId)).data.lastTriageEventId == eventId
            && getAfter(ticketPath(tenantId, ticketId)).data.updatedAt == request.time
            && request.resource.data.fromTitle == get(ticketPath(tenantId, ticketId)).data.title
            && request.resource.data.toTitle == getAfter(ticketPath(tenantId, ticketId)).data.title
            && request.resource.data.fromCategory == get(ticketPath(tenantId, ticketId)).data.category
            && request.resource.data.toCategory == getAfter(ticketPath(tenantId, ticketId)).data.category
            && request.resource.data.fromPriority == get(ticketPath(tenantId, ticketId)).data.priority
            && request.resource.data.toPriority == getAfter(ticketPath(tenantId, ticketId)).data.priority
            && (
              (request.resource.data.fromCategory == null
                && request.resource.data.toCategory != null
                && request.resource.data.type == 'classified')
              || (request.resource.data.fromCategory != null
                && request.resource.data.type == 'reclassified')
              || (request.resource.data.fromCategory == request.resource.data.toCategory
                && request.resource.data.fromPriority == request.resource.data.toPriority
                && request.resource.data.type == 'title_changed')
            );
          allow update, delete: if false;
        }

        // Anexos: metadados visíveis apenas a quem pode ler o sinal.
        // Cliente pode criar somente um pedido pendente; apenas backend poderá
        // confirmar que o arquivo realmente existe e liberar sua apresentação.
        match /attachments/{attachmentId} {
          allow read: if canReadTicket(tenantId, ticketId);
          allow create: if canReplyToTicket(tenantId, ticketId)
            && attachmentId.matches('^[A-Za-z0-9_-]{20,64}$')
            && request.resource.data.keys().hasOnly([
              'fileName','storagePath','contentType','size',
              'uploadedByUid','origin','status','createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'fileName','storagePath','contentType','size',
              'uploadedByUid','origin','status','createdAt'
            ])
            && request.resource.data.fileName is string
            && request.resource.data.fileName.size() >= 1
            && request.resource.data.fileName.size() <= 120
            && request.resource.data.storagePath ==
              'tenants/' + tenantId + '/tickets/' + ticketId + '/attachments/' + attachmentId
            && request.resource.data.contentType in [
              'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
            ]
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 10 * 1024 * 1024
            && request.resource.data.uploadedByUid == request.auth.uid
            && request.resource.data.origin == 'conversation'
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /messages/{messageId} {
          allow read: if canReadTicket(tenantId, ticketId);

          allow create: if (
            canReplyToTicket(tenantId, ticketId)
            || (
              activeMember(tenantId)
              && !exists(ticketPath(tenantId, ticketId))
              && getAfter(ticketPath(tenantId, ticketId)).data.createdAt == request.time
              && getAfter(ticketPath(tenantId, ticketId)).data.firstMessageId == messageId
              && getAfter(ticketPath(tenantId, ticketId)).data.requesterUid == request.auth.uid
              && getAfter(ticketPath(tenantId, ticketId)).data.description == request.resource.data.body
              && getAfter(ticketPath(tenantId, ticketId)).data.category == null
              && getAfter(ticketPath(tenantId, ticketId)).data.priority == null
            )
          )
            && request.resource.data.keys().hasOnly([
              'body','visibility','authorUid','authorName',
              'authorEmail','authorRole','createdAt'
            ])
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 4000
            && request.resource.data.visibility == 'public'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName == get(userPath()).data.displayName
            && request.resource.data.authorEmail == get(userPath()).data.email
            && request.resource.data.authorRole == get(memberPath(tenantId)).data.role
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
